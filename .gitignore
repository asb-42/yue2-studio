target/
node_modules/
dist/
# The studio's live data root when kept beside the checkout (models, library,
# media, settings, logs, downloads): portable as one folder with the repo,
# never committed.
workdir/
# ...except the waveform editor's own bundle, which is shipped, not built.
!app/public/editor/dist/
!app/public/editor/dist/**
.env
.env.*
!.env.example
data/
!app/data/
app/data/changelog.json
models/
engines/*/bin/
*.db
*.db-shm
*.db-wal

# Model weights and datasets are runtime downloads, never sources. The
# directory rules above cover the conventional layouts; the extensions below
# catch a weight file dropped anywhere else by accident.
*.gguf
*.safetensors
*.onnx
*.onnx.data
*.pt
*.ckpt

# Built installers and portable archives belong to a GitHub release, not here.
release/
yue2-studio-linux-*.tar.gz

# Local engineering notes: they never belong to the published repository.
HANDOFF.md
NEXT_SESSION_PROMPT.md

# Local editor and agent settings.
.claude/
*.password
/target-check
/_archive-*
